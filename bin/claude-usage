#!/usr/bin/env bash
# claude-usage - Claude plan usage in your statusline, with history and projections
set -euo pipefail

# Resolve the real location of this script through symlinks
# (~/.local/bin/claude-usage -> <clone>/bin/claude-usage).
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
CU_BIN_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck disable=SC2034  # used by install-hook in lib/cli.sh
CU_SELF="${CU_BIN_DIR}/claude-usage"
unset _self _dir

# The Nix build substitutes @LIB_DIR@ and @VIEWS_DIR@; a git clone uses the
# directories next to bin/.
CU_LIB_DIR="@LIB_DIR@"
CU_VIEWS_DIR="@VIEWS_DIR@"
CU_ROOT_DIR=""
if [ "$CU_LIB_DIR" = "@""LIB_DIR""@" ]; then
    CU_ROOT_DIR="$(cd "${CU_BIN_DIR}/.." && pwd)"
    CU_LIB_DIR="${CU_ROOT_DIR}/lib"
    CU_VIEWS_DIR="${CU_ROOT_DIR}/views"
fi

for _dep in jq curl awk; do
    if ! command -v "$_dep" >/dev/null 2>&1; then
        echo "Error: '$_dep' is required but not found. Install it and try again." >&2
        exit 1
    fi
done
unset _dep

# shellcheck source=../lib/load.sh
source "${CU_LIB_DIR}/load.sh"

cu_main "$@"
